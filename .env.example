# Copy this file to .env and fill in values locally. Never commit .env.

# --- Neo4j (required unless --no-neo4j is passed) ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=

# --- LLM endpoint ---
# With llm.provider=local (vLLM), base_url normally comes from config/base.yaml and no
# key is needed; vLLM requires a key to be present but ignores its value.
# Set these to point at a different OpenAI-compatible endpoint, or for provider=api.
LLM_API_KEY=
LLM_API_BASE_URL=

# --- Server runner (scripts/server_run.sh) ---
# All optional: the script has sensible defaults for every one of these. Set only what
# your server actually needs. Non-secret values, but .env is the single place for them.
#
# SCHAIN_TMUX_SESSION=schain              # tmux session name for the detached run
#
# vLLM deployment
# SCHAIN_VLLM_MODEL=                      # defaults to llm.model from config/base.yaml
# SCHAIN_VLLM_MAX_MODEL_LEN=16384
# SCHAIN_VLLM_GPU_MEMORY_UTILIZATION=0.90
# SCHAIN_VLLM_TENSOR_PARALLEL_SIZE=       # defaults to the number of visible GPUs
# SCHAIN_VLLM_EXTRA_ARGS=                 # any extra flags passed to `vllm serve`
# SCHAIN_VLLM_STARTUP_TIMEOUT=1800        # seconds to wait for the model to load
#
# Neo4j container, used only when nothing is reachable at NEO4J_URI
# SCHAIN_NEO4J_CONTAINER=schain-neo4j
# SCHAIN_NEO4J_IMAGE=neo4j:5
# SCHAIN_NEO4J_DATA_DIR=                  # defaults to <repo>/neo4j_data (gitignored)
# SCHAIN_NEO4J_STARTUP_TIMEOUT=120
#
# Smoke test scope
# SCHAIN_SMOKE_MAX_TIER=0
# SCHAIN_SMOKE_MAX_DOCUMENTS=3
# SCHAIN_SMOKE_INPUT=docs/SupplyChain_KG_V1_Architecture_Brief_Final.pdf
#
# SLURM. Needed only if the server uses SLURM, no GPU is visible in your shell, and no
# LLM endpoint is already running. The script names exactly what is missing and how to
# find it. See docs/SERVER_REQUIRED_INFO.md.
#
# A smoke test uses an interactive srun allocation; production submits an sbatch job,
# because interactive sessions are capped (2h on Neumann) whatever --time asks for.
# SCHAIN_SLURM_PARTITION=                 # required in that case (Neumann: ampere)
# SCHAIN_SLURM_ACCOUNT=                   # only if your cluster requires one (Neumann: ampere)
# SCHAIN_SLURM_GRES=gpu:1                 # Neumann A100: gpu:a100_80gb:1
# SCHAIN_SLURM_TIME=24:00:00              # production batch job time limit
# SCHAIN_SLURM_SMOKE_TIME=02:00:00        # interactive smoke test, within the cap
# SCHAIN_SLURM_CPUS=8
# SCHAIN_SLURM_MEM=
# SCHAIN_SLURM_JOB_NAME=

# Local Neo4j, used when NEO4J_URI is not reachable and Docker is unavailable.
# Installed from the official tarball into .runtime/neo4j (gitignored). Needs Java 21+.
# SCHAIN_NEO4J_VERSION=5.26.0
# SCHAIN_RUNTIME_DIR=                     # defaults to <repo>/.runtime
# SCHAIN_NEO4J_SKIP_BOLT_CHECK=           # set to 1 to trust an open port without a handshake

# vLLM is installed into .venv on first use when a GPU is present. Set to 0 to install
# it yourself instead.
# SCHAIN_VLLM_AUTO_INSTALL=1

# --- Hugging Face (only if the model needs authentication or a shared cache) ---
# HF_TOKEN=
# HF_HOME=

# --- General-web retrieval (optional) ---
# The general_web provider defaults to the DuckDuckGo backend, which needs no key.
# Set this and `backend: brave` in config/expansion.yaml to use the official Brave
# Search API instead, which is more reliable over a long run.
# BRAVE_SEARCH_API_KEY=

# --- Optional test switches ---
# Wikipedia, GDELT and Google News need no credentials.
# SCHAIN_RUN_LLM_TESTS=1        run the integration tests that call the model endpoint
# SCHAIN_RUN_NETWORK_TESTS=1    run the integration tests that query the public search APIs

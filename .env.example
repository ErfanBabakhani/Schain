# Copy this file to .env and fill values locally.
# Never commit .env.

# Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=

# Optional API-based LLM provider
LLM_API_KEY=
LLM_API_BASE_URL=

# Optional search/retrieval credentials if a chosen provider needs them
SEARCH_API_KEY=

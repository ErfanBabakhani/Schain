+        if _optional_bool(quality.get("frontier_eligible")) is False:
+            continue
+        if quality.get("contested") is True or quality.get("status") == "contested":
+            continue
+        parents.setdefault(edge["source"], set()).add(edge["target"])
+    return parents
 
 

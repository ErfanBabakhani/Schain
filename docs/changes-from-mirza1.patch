+def _optional_bool(value: Any) -> Optional[bool]:
+    """Keep absent legacy validation flags unknown, including pandas nulls."""
+    value = json_safe(value)
+    if isinstance(value, bool):
+        return value
+    if value in (0, 1):
+        return bool(value)
+    return None

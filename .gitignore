# Secrets and local environment
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so
.venv/
venv/
env/
.python-version

# Test / lint / type-check caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Notebooks and editor files
.ipynb_checkpoints/
.vscode/
.idea/
.DS_Store

# Logs and temporary files
*.log
logs/
tmp/
temp/
.cache/

# Runtime state / checkpoints / local databases
data/state/*
!data/state/.gitkeep
*.db
*.sqlite
*.sqlite3

# Retrieved and generated data
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/external/*
!data/external/.gitkeep
data/visualizations/*
!data/visualizations/.gitkeep
outputs/

# Runtime tooling installed by scripts/server_run.sh: local Neo4j distribution and its
# data/logs, and generated SLURM batch files.
.runtime/

# Local Neo4j data, if a local instance/volume is used
neo4j_data/
.neo4j/
neo4j/data/
neo4j/logs/
neo4j/import/

# Model files / local model cache
models/
checkpoints/
*.safetensors
*.gguf
*.ckpt
huggingface_cache/

# Build / packaging
build/
dist/
*.egg-info/

# Archives (the starter pack's contents are tracked unpacked at the repo root)
*.zip
